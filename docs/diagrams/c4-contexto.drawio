<mxfile host="drawio" agent="pan-de-la-casa" version="24.0.0"><diagram id="p0" name="Contexto (C4 nivel 1)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Pan de la Casa · Diagrama de contexto (C4 nivel 1)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#1B2A8F;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Personas y sistemas externos que interactúan con el sistema. Línea punteada = planeado." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5C6370;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:14px&quot;&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Vecino que consulta el catálogo y encarga pan para recoger, desde el celular." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;dashed=0;fillColor=#083F75;strokeColor=#06315C;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="220" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:14px&quot;&gt;Administrador de la panadería&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Revisa los pedidos del día y actualiza productos y precios." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;dashed=1;fillColor=#5B7FA6;strokeColor=#06315C;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="220" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Equipo técnico&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Persona]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Mantiene el sistema: sube cambios y atiende alertas." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;dashed=0;fillColor=#083F75;strokeColor=#06315C;fontColor=#FFFFFF;shape=mxgraph.c4.person2;align=center;metaEdit=1;resizable=0;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="220" height="190" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:14px&quot;&gt;Pan de la Casa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Sitio web y API: catálogo con fotos y precios, y pedidos con hora de recogida. Corre en Azure." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="380" height="150" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Autentica al administrador del panel." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="260" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:14px&quot;&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Guarda el código y despliega con GitHub Actions." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1040" y="420" width="260" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Correo electrónico&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/span&gt;&lt;br&gt;&lt;br&gt;Entrega las alertas de fallos y de presupuesto de Azure Monitor." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#8C8496;strokeColor=#736782;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1040" y="660" width="260" height="120" as="geometry"/></mxCell><mxCell id="c10" value="Consulta el catálogo y registra pedidos&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Revisa pedidos y cambia precios&lt;br&gt;[HTTPS] (planeado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;dashed=1;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="Delega el inicio de sesión del administrador&lt;br&gt;[OIDC] (planeado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;dashed=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="537" y="720"/></Array></mxGeometry></mxCell><mxCell id="c13" value="Sube cambios por pull request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Despliega dev y prod&lt;br&gt;[OIDC]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;" edge="1" parent="1" source="c8" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="Envía alertas&lt;br&gt;(Azure Monitor)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="803" y="720"/></Array></mxGeometry></mxCell><mxCell id="c16" value="Avisa al equipo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="720"/><mxPoint x="1340" y="252"/></Array></mxGeometry></mxCell><mxCell id="c17" value="Fuera del alcance: pagos en línea (se paga en la tienda al recoger), domicilios e inventario. Hoy los precios se cambian en data/catalog.json por pull request; el panel de administrador está planeado." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5C6370;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="360" y="800" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

<mxfile host="drawio" agent="pan-de-la-casa" version="24.0.0"><diagram id="p0" name="Red y seguridad"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Pan de la Casa · Red y seguridad: zonas, flujos e identidades" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=20;fontColor=#1B2A8F;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c2" value="MVP desplegado; los cambios de producción están indicados. Sin VNet: todos los servicios son PaaS con endpoint público protegido por TLS y autenticación." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#5C6370;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="Internet · no confiable" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#B42318;fillColor=#FEF3F2;strokeColor=#B42318;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="230" height="470" as="geometry"/></mxCell><mxCell id="c4" value="Borde · Static Web Apps" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=1;fontColor=#0078D4;fillColor=#F3F8FD;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="300" height="470" as="geometry"/></mxCell><mxCell id="c5" value="Datos y telemetría · PaaS" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontStyle
l=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="③ HTTPS · clave (MVP)&lt;br&gt;RBAC (producción)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="375"/><mxPoint x="605" y="220"/></Array></mxGeometry></mxCell><mxCell id="c22" value="④ telemetría" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="⑤ token OIDC → token de Azure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="674"/><mxPoint x="1300" y="168"/></Array></mxGeometry></mxCell><mxCell id="c24" value="⑥ Bicep" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1170" y="600"/><mxPoint x="1280" y="600"/><mxPoint x="1280" y="318"/></Array></mxGeometry></mxCell><mxCell id="c25" value="⑦ token de despliegue&lt;br&gt;pedido en ejecución&lt;br&gt;y enmascarado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=11;endArrow=block;endFill=1;strokeColor=#5C6370;strokeWidth=1.5;labelBackgroundColor=#FFFFFF;fontColor=#1F2328;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="674"/><mxPoint x="950" y="128"/><mxPoint x="560" y="128"/><mxPoint x="560" y="220"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Identidades y secretos" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#1B2A8F;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="900" height="22" as="geometry"/></mxCell><mxCell id="c27" value="id-pandelacasa-github" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#EEF3F5;strokeColor=#CFD8E1;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="210" height="46" as="geometry"/></mxCell><mxCell id="c28" value="Identidad administrada con 4 credenciales federadas (environments dev y prod). Rol Contributor solo sobre rg-pandelacasa. Sin secretos guardados en GitHub." style="rounded=0;align=left;spacingLeft=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8E1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="230" y="630" width="700" height="46" as="geometry"/></mxCell><mxCell id="c29" value="Clave de Cosmos DB (MVP)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#EEF3F5;strokeColor=#CFD8E1;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="676" width="210" height="46" as="geometry"/></mxCell><mxCell id="c30" value="Bicep la escribe en la configuración de cada Static Web App. Nunca está en el repositorio ni en los logs. Las managed functions no admiten identidad administrada." style="rounded=0;align=left;spacingLeft=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8E1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="230" y="676" width="700" height="46" as="geometry"/></mxCell><mxCell id="c31" value="Producción" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#EEF3F5;strokeColor=#CFD8E1;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="722" width="210" height="46" as="geometry"/></mxCell><mxCell id="c32" value="La Function App usa su identidad administrada: RBAC en Cosmos DB (sin clave) y lectura de Key Vault. Se desactiva la autenticación por clave." style="rounded=0;align=left;spacingLeft=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8E1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="230" y="722" width="700" height="46" as="geometry"/></mxCell><mxCell id="c33" value="ALERT_EMAIL" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#EEF3F5;strokeColor=#CFD8E1;fontColor=#1F2328;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="768" width="210" height="46" as="geometry"/></mxCell><mxCell id="c34" value="Secreto de GitHub: el repositorio y los logs del pipeline son públicos." style="rounded=0;align=left;spacingLeft=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#CFD8E1;fontColor=#1F2328;" vertex="1" parent="1"><mxGeometry x="230" y="768" width="700" height="46" as="geometry"/></mxCell><mxCell id="c35" value="Riesgos aceptados en el MVP (Checkov): CKV_AZURE_99 y CKV_AZURE_101, Cosmos DB con acceso de red público (Static Web Apps no ofrece integración con red virtual de salida); CKV_AZURE_140, autenticación por clave habilitada (lo exigen las managed functions). Justificación en docs/despliegue.md." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#5C6370;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1250" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
